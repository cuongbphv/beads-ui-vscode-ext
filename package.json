{
  "name": "beads-dashboard",
  "displayName": "Beads Dashboard — Kanban & Roadmap",
  "description": "Dashboard for the beads (bd) issue tracker: Overview, Roadmap and Kanban board, plus an Epic → Task sidebar.",
  "version": "0.1.2",
  "publisher": "cuongbphv",
  "license": "MIT",
  "author": "Bùi Phan Viết Cường",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuongbphv/beads-ui-vscode-ext.git"
  },
  "homepage": "https://github.com/cuongbphv/beads-ui-vscode-ext#readme",
  "bugs": {
    "url": "https://github.com/cuongbphv/beads-ui-vscode-ext/issues"
  },
  "qna": "https://github.com/cuongbphv/beads-ui-vscode-ext/discussions",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "beads",
    "bd",
    "kanban",
    "issue tracker",
    "roadmap",
    "gantt",
    "agent",
    "ai",
    "claude code",
    "dolt"
  ],
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.beads"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beadsDashboard",
          "title": "Beads",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "beadsDashboard": [
        {
          "id": "beadsDashboard.needsYou",
          "name": "Needs You",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Beads",
          "visibility": "visible",
          "initialSize": 1
        },
        {
          "id": "beadsDashboard.tree",
          "name": "Epics & Milestones",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Beads",
          "visibility": "visible",
          "initialSize": 4
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "beadsDashboard.tree",
        "contents": "No beads workspace detected here.\n\nThis folder has no `.beads` directory, or the `bd` CLI is not on your PATH.\n\n[Open the Beads Dashboard](command:beadsDashboard.openDashboard)\n[Check Setup](command:beadsDashboard.showOutput)"
      }
    ],
    "commands": [
      {
        "command": "beadsDashboard.openDashboard",
        "title": "Open Dashboard",
        "category": "Beads",
        "icon": "$(dashboard)"
      },
      {
        "command": "beadsDashboard.refresh",
        "title": "Refresh",
        "category": "Beads",
        "icon": "$(refresh)"
      },
      {
        "command": "beadsDashboard.showOutput",
        "title": "Show bd Output Log",
        "category": "Beads",
        "icon": "$(output)"
      },
      {
        "command": "beadsDashboard.openBead",
        "title": "Open Issue",
        "category": "Beads"
      },
      {
        "command": "beadsDashboard.setStatus",
        "title": "Change Status…",
        "category": "Beads",
        "icon": "$(circle-outline)"
      },
      {
        "command": "beadsDashboard.setPriority",
        "title": "Change Priority…",
        "category": "Beads",
        "icon": "$(arrow-up)"
      },
      {
        "command": "beadsDashboard.setAssignee",
        "title": "Change Assignee…",
        "category": "Beads",
        "icon": "$(person)"
      },
      {
        "command": "beadsDashboard.claim",
        "title": "Claim (assign to me, set in progress)",
        "category": "Beads",
        "icon": "$(check)"
      },
      {
        "command": "beadsDashboard.closeBead",
        "title": "Close Issue…",
        "category": "Beads",
        "icon": "$(pass)"
      },
      {
        "command": "beadsDashboard.copyId",
        "title": "Copy Issue ID",
        "category": "Beads",
        "icon": "$(copy)"
      },
      {
        "command": "beadsDashboard.resolveGate",
        "title": "Resolve Gate…",
        "category": "Beads",
        "icon": "$(pass)"
      },
      {
        "command": "beadsDashboard.selectFolder",
        "title": "Select Beads Folder…",
        "category": "Beads",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "beadsDashboard.openDashboard",
          "when": "view == beadsDashboard.tree",
          "group": "navigation@1"
        },
        {
          "command": "beadsDashboard.refresh",
          "when": "view == beadsDashboard.tree",
          "group": "navigation@2"
        },
        {
          "command": "beadsDashboard.showOutput",
          "when": "view == beadsDashboard.tree",
          "group": "1_diagnostics"
        },
        {
          "command": "beadsDashboard.selectFolder",
          "when": "view == beadsDashboard.tree",
          "group": "1_diagnostics@2"
        }
      ],
      "view/item/context": [
        {
          "command": "beadsDashboard.claim",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem =~ /^bead/",
          "group": "inline@1"
        },
        {
          "command": "beadsDashboard.setStatus",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem =~ /^bead/",
          "group": "1_edit@1"
        },
        {
          "command": "beadsDashboard.setPriority",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem =~ /^bead/",
          "group": "1_edit@2"
        },
        {
          "command": "beadsDashboard.setAssignee",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem =~ /^bead/",
          "group": "1_edit@3"
        },
        {
          "command": "beadsDashboard.closeBead",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem == beadOpen",
          "group": "2_close@1"
        },
        {
          "command": "beadsDashboard.copyId",
          "when": "view =~ /^beadsDashboard\\.(tree|needsYou)$/ && viewItem =~ /^bead/",
          "group": "9_copy@1"
        },
        {
          "command": "beadsDashboard.resolveGate",
          "when": "view == beadsDashboard.needsYou && viewItem == gate",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "beadsDashboard.openBead",
          "when": "false"
        },
        {
          "command": "beadsDashboard.setStatus",
          "when": "false"
        },
        {
          "command": "beadsDashboard.setPriority",
          "when": "false"
        },
        {
          "command": "beadsDashboard.setAssignee",
          "when": "false"
        },
        {
          "command": "beadsDashboard.claim",
          "when": "false"
        },
        {
          "command": "beadsDashboard.closeBead",
          "when": "false"
        },
        {
          "command": "beadsDashboard.copyId",
          "when": "false"
        },
        {
          "command": "beadsDashboard.resolveGate",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Beads Dashboard",
      "properties": {
        "beadsDashboard.bdPath": {
          "type": "string",
          "default": "bd",
          "markdownDescription": "Path to the `bd` executable. Leave as `bd` to use your PATH."
        },
        "beadsDashboard.defaultTab": {
          "type": "string",
          "enum": [
            "overview",
            "roadmap",
            "board"
          ],
          "default": "overview",
          "description": "Tab the dashboard opens on."
        },
        "beadsDashboard.issueLimit": {
          "type": "number",
          "default": 2000,
          "minimum": 50,
          "description": "Maximum number of issues loaded per refresh. Larger projects paint more slowly."
        },
        "beadsDashboard.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "Seconds between checks for changes made outside the editor — by an agent, a teammate, or your own terminal. Each check is a single `bd list --limit 1`; the full reload only runs when something actually changed, and nothing is checked while every Beads view is hidden or the window is in the background. `0` disables it entirely."
        },
        "beadsDashboard.showClosed": {
          "type": "boolean",
          "default": true,
          "description": "Include closed issues in the board and the sidebar tree."
        },
        "beadsDashboard.assignee": {
          "type": "string",
          "default": "",
          "markdownDescription": "Who you are in beads, for the sidebar's **Needs You** section. Leave empty to use the same identity `bd` does: `BEADS_ACTOR`, then `BD_ACTOR`, then `git config user.name`, then your OS username."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node esbuild.mjs",
    "build:css": "tailwindcss -i src/webview/styles/globals.css -o dist/webview.css",
    "build:prod": "node esbuild.mjs --production && tailwindcss -i src/webview/styles/globals.css -o dist/webview.css --minify",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:electron": "node scripts/run-electron-test.mjs",
    "test:webview": "node scripts/run-webview-test.mjs",
    "preview": "npm run build && node scripts/render-preview.mjs",
    "capture": "npm run build && node scripts/capture-screens.mjs",
    "demo:seed": "node scripts/seed-demo-workspace.mjs --force",
    "capture:demo": "npm run demo:seed && npm run build && node scripts/capture-screens.mjs --demo",
    "gif": "npm run demo:seed && npm run build && node scripts/record-demo.mjs",
    "audit:ci": "npm audit --audit-level=low",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "install:local": "node scripts/install-local.mjs",
    "vscode:prepublish": "npm run build:prod",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:ci"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "~1.105.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
